<UserControl x:Class="tool_cantam.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="PAROLA YONETICI" Foreground="#00FF9C" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Guvenli uretim ve gucluluk analiz protokolu." Foreground="#555" FontSize="12" Margin="0,0,0,30"/>

            <UniformGrid Columns="2">
                <!-- Parola Uretme Bolumu -->
                <Border Background="#0D0D12" CornerRadius="15" Padding="25" Margin="0,0,10,0" BorderBrush="#1F1F24" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="YENI ANAHTAR URET" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBox x:Name="TxtGenerated" Background="#050505" Foreground="White" BorderBrush="#1F1F24" Padding="15" FontSize="16" IsReadOnly="True" Margin="0,0,0,15" Text="uretmek icin tikla" TextChanged="TxtGenerated_TextChanged"/>

                        <Button x:Name="BtnGenerate" Click="BtnGenerate_Click" Content="URET &amp; KOPYALA" Background="#00FF9C" Foreground="Black" FontWeight="Bold" Height="45" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Parola Analiz Bolumu -->
                <Border Background="#0D0D12" CornerRadius="15" Padding="25" Margin="10,0,0,0" BorderBrush="#1F1F24" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GUCLULUK ANALIZORU" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Test Edilecek Parola" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtTest" Background="#050505" Foreground="White" BorderBrush="#1F1F24" Padding="15" Margin="0,0,0,15" TextChanged="TxtTest_TextChanged"/>

                        <TextBlock Text="Guvenlik Seviyesi:" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>

                        <ProgressBar x:Name="StrengthBar" Value="0" Maximum="100" Height="8" Background="#1A1A1F" BorderThickness="0" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Puan: " Foreground="#666" FontSize="11"/>
                            <TextBlock x:Name="ScoreText" Text="0" Foreground="#00FF9C" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=" / 100" Foreground="#666" FontSize="11"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Text="DURUM: BEKLENIYOR..." Foreground="#FFA500" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
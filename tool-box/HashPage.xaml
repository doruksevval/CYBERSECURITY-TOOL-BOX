<UserControl x:Class="tool_cantam.HashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <StackPanel>
                <TextBlock Text="HASH URETICI" Foreground="#00FF9C" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>

                <Border Background="#0D0D12" CornerRadius="15" Padding="25" BorderBrush="#1F1F24" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ALGORITMA SEC" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbAlgorithm" Background="#1F1F24" Foreground="Black" Margin="0,0,0,20" Padding="10">
                            <ComboBoxItem Content="SHA-256" IsSelected="True"/>
                            <ComboBoxItem Content="MD5"/>
                            <ComboBoxItem Content="SHA-1"/>
                        </ComboBox>

                        <TextBlock Text="HASH'LENECEK VERI" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtHashInput" Height="80" Background="#050505" Foreground="White" BorderBrush="#1F1F24" Padding="10" Margin="0,0,0,20" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <Button x:Name="BtnCompute" Click="BtnCompute_Click" Content="HASH HESAPLA" Height="45" Background="#00FF9C" Foreground="Black" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <ProgressBar x:Name="HashProgress" Value="0" Height="4" Foreground="#00FF9C" Background="#050505" BorderThickness="0" Margin="0,20,0,0"/>
                        <TextBlock x:Name="StatusText" Text="HAZIR" Foreground="#444" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0"/>

                        <TextBlock Text="HASH SONUCU" Foreground="#666" FontSize="11" Margin="0,15,0,10"/>
                        <TextBox x:Name="TxtHashResult" IsReadOnly="True" Background="#050505" Foreground="#00FF9C" BorderBrush="#1F1F24" Padding="15" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="" Height="20"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
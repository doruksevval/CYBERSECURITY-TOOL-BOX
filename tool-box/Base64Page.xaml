<UserControl x:Class="tool_cantam.Base64Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#050505"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1F1F24" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <StackPanel>
                <TextBlock Text="BASE64 ARACI" Foreground="#00FF9C" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Metni Base64 formatina donustur ve tersini yap." Foreground="#555" FontSize="12" Margin="0,0,0,30"/>

                <Border Background="#0D0D12" CornerRadius="15" Padding="25" BorderBrush="#1F1F24" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="GIRIS METNI" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtInput" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Background="#050505" Foreground="White" BorderBrush="#1F1F24" Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                            <Button x:Name="BtnEncode" Click="BtnEncode_Click" Content="KODLA ➔" Width="120" Height="35" Background="#00FF9C" Foreground="Black" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDecode" Click="BtnDecode_Click" Content="COZ ⬅" Width="120" Height="35" Background="Transparent" Foreground="#00FF9C" BorderBrush="#00FF9C" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="SONUC" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtOutput" Height="100" TextWrapping="Wrap" IsReadOnly="True" Background="#050505" Foreground="#00FF9C" BorderBrush="#1F1F24" Padding="10"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>